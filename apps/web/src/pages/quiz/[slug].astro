---
import Layout from "@/layouts/Layout.astro";
import QuizHero from "@/components/quiz/landing/QuizHero.astro";
import QuizByline from "@/components/quiz/landing/QuizByline.astro";
import QuizAbout from "@/components/quiz/landing/QuizAbout.astro";
import QuizOutcomes from "@/components/quiz/landing/QuizOutcomes.astro";
import QuizRelated from "@/components/quiz/landing/QuizRelated.astro";
import CommentSection from "@/components/quiz/CommentSection";
import AdSlot from "@/components/ads/AdSlot";
import { apiFetch } from "@/lib/api";
import { apiUnavailableResponse, isApiUnavailable } from "@/lib/api-unavailable";
import { getProfile } from "@/lib/api-server";
import { BRAND_DISCLAIMER } from "@/lib/legal";
import { landingOutcomes, landingQuestions, type LandingQuiz, type RelatedQuiz } from "@/lib/quiz-landing";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/");

const { data, error, status } = await apiFetch(`/quizzes/${slug}`);

if (error || !data) {
  if (isApiUnavailable({ error, status })) {
    return apiUnavailableResponse(Astro.url.pathname, { error, status });
  }
  const redirect = await apiFetch(`/quizzes/redirect/${slug}`);
  if (redirect.data?.new_slug) {
    return Astro.redirect(`/quiz/${redirect.data.new_slug}`, 301);
  }
  if (isApiUnavailable(redirect)) {
    return apiUnavailableResponse(Astro.url.pathname, redirect);
  }
  return Astro.redirect("/404");
}

const quiz: LandingQuiz = data;
const title = `${quiz.title} | FunSona`;
const description = quiz.description || `Jogue o quiz ${quiz.title} no FunSona`;
const image = `${Astro.url.origin}/og/${slug}`;

// "Mais para jogar": curated quizzes sharing this quiz's first tag, or the most played when there
// is no tag or nothing else carries it. Both listings are curated-only since AdSense slice 2.
const notSelf = (list: RelatedQuiz[] | null): RelatedQuiz[] => (list || []).filter((q) => q.id !== quiz.id).slice(0, 3);
const tag = quiz.tags?.[0];
let related: RelatedQuiz[] = tag ? notSelf((await apiFetch(`/quizzes?tag=${encodeURIComponent(tag)}&limit=4`)).data) : [];
if (related.length === 0) {
  related = notSelf((await apiFetch(`/quizzes?limit=4&sort=plays`)).data);
}

// The outcomes are published as static HTML on this canonical URL: they are the text crawlers and
// the AdSense reviewer read. The questions are not; they belong to /play, and the landing only
// counts them for the meta line.
const questions = landingQuestions(quiz.content);
const outcomes = landingOutcomes(quiz.content);

// Current user for the comment section — null for anonymous visitors, who
// still get the full page.
const currentUserId = (await getProfile(Astro))?.id ?? null;

// One flag decides whether Google sees this quiz at all: a curated quiz is
// indexed and carries ad code; any other quiz is noindex and carries none.
// It stays playable by direct link. See docs/research/2026-10-18-adsense-noindex-review.
const curated = Boolean(quiz.ads_eligible);
---

<Layout title={title} description={description} image={image} canonical={`/quiz/${slug}`} lang={quiz.language || "pt"} noindex={!curated} ads={curated}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Quiz",
    name: quiz.title,
    description: quiz.description,
    image: image,
    author: {
      "@type": "Person",
      name: quiz.author?.display_name || quiz.author?.handle,
    },
    datePublished: quiz.created_at,
  })} />

  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[34rem] bg-[radial-gradient(circle_at_25%_10%,rgba(99,102,241,0.18),transparent_34%),radial-gradient(circle_at_80%_20%,rgba(168,85,247,0.16),transparent_30%)]"></div>

    <QuizHero quiz={quiz} questionCount={questions.length} />

    {/* One column on a phone, in DOM order. From lg the reading stays left and the byline and
        the related list go right; every left item names its column so auto-placement cannot
        drift into the right one. */}
    <div class="relative mx-auto grid max-w-7xl gap-6 px-4 pb-8 pt-3 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-8 lg:px-8 lg:pt-7">
      <QuizByline quizId={quiz.id} author={quiz.author} likesCount={quiz.likes_count || 0} currentUserId={currentUserId} class="lg:col-start-2 lg:row-start-1" />
      <QuizAbout intro={quiz.intro_content} class="lg:col-start-1" />
      <QuizOutcomes outcomes={outcomes} class="lg:col-start-1" />

      {curated && (
        <div class="lg:col-start-1">
          <AdSlot slot="quiz-landing" client:visible />
        </div>
      )}

      <div class="rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-4 shadow-xl shadow-slate-950/5 sm:p-5 lg:col-start-1 dark:shadow-black/20">
        <CommentSection quizSlug={slug} currentUserId={currentUserId} client:load />
      </div>

      <QuizRelated quizzes={related} class="lg:sticky lg:top-28 lg:col-start-2 lg:row-span-3 lg:row-start-2 lg:self-start" />
    </div>

    <p class="relative mx-auto max-w-7xl px-4 pb-10 text-xs leading-relaxed text-[var(--color-text-muted)] sm:px-6 lg:px-8">{BRAND_DISCLAIMER}</p>
  </div>
</Layout>
