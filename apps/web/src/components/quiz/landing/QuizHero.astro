---
import type { LandingQuiz } from "@/lib/quiz-landing";

// One job above the fold: the banner (cover or gradient), the title, the description, one meta
// line and one Play. Everything else the old hero carried (chips, like, tags, disclaimer, the
// cover card with its counts and dates) moved to the byline or to the end of the page.
interface Props {
  quiz: LandingQuiz;
  questionCount: number;
}

const { quiz, questionCount } = Astro.props;

// Ten questions read as about three minutes; a shorter quiz never claims less than one.
const minutes = Math.max(1, Math.round(questionCount * 0.3));
const typeLabel = quiz.type === "TRIVIA" ? "Trivia" : "Personalidade";
const meta = [
  ...(questionCount > 0 ? [`${questionCount} perguntas`, `~${minutes} min`] : []),
  typeLabel,
].join(" · ");
---

<!-- On a phone the banner starts behind the floating navbar (the layout's 5.8rem spacer is pulled
     back), so the first viewport is the quiz, not a top margin. From lg it is a rounded card. -->
<section class="relative -mt-[5.8rem] lg:mx-auto lg:mt-3 lg:max-w-7xl lg:px-8">
  <div class="relative isolate flex min-h-[34rem] flex-col justify-end overflow-hidden bg-gradient-to-br from-brand-600 via-brand-500 to-accent-600 px-4 pb-6 pt-28 text-white sm:px-6 lg:min-h-[26rem] lg:rounded-[2rem] lg:px-10 lg:pb-10 lg:pt-16 lg:shadow-2xl lg:shadow-black/30">
    {quiz.cover_url ? (
      <img src={quiz.cover_url} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    ) : (
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.32),transparent_30%),radial-gradient(circle_at_85%_35%,rgba(255,255,255,0.14),transparent_28%)]"></div>
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-slate-950 via-slate-950/65 to-slate-950/5 lg:from-slate-950/90 lg:via-slate-950/55 lg:to-transparent"></div>

    <div class="max-w-3xl">
      <h1 class="text-3xl font-black leading-[1.06] tracking-tight drop-shadow-[0_2px_18px_rgba(0,0,0,0.45)] sm:text-4xl lg:text-5xl xl:text-[3.25rem]">
        {quiz.title}
      </h1>
      {quiz.description && (
        <p class="mt-3 text-[15px] font-medium leading-relaxed text-white/85 drop-shadow-[0_1px_10px_rgba(0,0,0,0.5)] sm:text-lg">
          {quiz.description}
        </p>
      )}

      <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-center lg:gap-6">
        <p class="text-xs font-extrabold uppercase tracking-[0.12em] text-white/80 lg:order-last">{meta}</p>
        <a href={`/quiz/${quiz.slug}/play`} class="group flex h-14 items-center justify-center gap-3 rounded-[1.1rem] bg-gradient-to-r from-brand-600 via-brand-500 to-accent-600 px-7 text-lg font-black text-white shadow-2xl shadow-brand-500/30 transition hover:-translate-y-0.5 hover:shadow-brand-500/40 lg:self-start">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/20 transition group-hover:scale-105">
            <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          </span>
          Jogar agora
        </a>
      </div>
    </div>
  </div>
</section>
