---
import { BRAND_DISCLAIMER } from "@/lib/legal";

const footerLinks = {
  product: {
    title: "Produto",
    links: [
      { label: "Explorar", href: "/explore" },
      { label: "Ranking", href: "/leaderboard" },
      { label: "Premium", href: "/premium" },
      { label: "Criar Quiz", href: "/quiz/new" },
      { label: "Guias", href: "/guides" },
    ],
  },
  categories: {
    title: "Categorias",
    links: [
      { label: "Personalidade", href: "/explore/personality" },
      { label: "Trivia", href: "/explore/trivia" },
      { label: "Games", href: "/explore/games" },
      { label: "Filmes", href: "/explore/movies" },
    ],
  },
  support: {
    title: "Suporte",
    links: [
      { label: "Termos de Uso", href: "/terms" },
      { label: "Privacidade", href: "/privacy" },
      { label: "Contato", href: "/contact" },
    ],
  },
};
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface-elevated)] transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main footer content -->
    <div class="py-12 grid grid-cols-2 md:grid-cols-5 gap-8">
      <!-- Brand column -->
      <div class="col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5 mb-4 group">
          <div class="w-9 h-9 rounded-xl bg-[var(--color-surface)] ring-1 ring-[var(--color-border)] flex items-center justify-center shadow-lg shadow-brand-500/20 group-hover:shadow-brand-500/40 transition-shadow">
            <img src="/favicon-32x32.png" alt="FunSona" class="w-6 h-6" loading="lazy" decoding="async" />
          </div>
          <span class="text-xl font-black tracking-tight text-[var(--color-text-primary)]">FunSona</span>
        </a>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed max-w-xs mb-6">
          Plataforma independente de quizzes de personalidade e trivia. Crie, jogue e compartilhe.
        </p>
      </div>

      <!-- Link columns -->
      {Object.values(footerLinks).map((section) => (
        <div>
          <h3 class="text-sm font-bold text-[var(--color-text-primary)] uppercase tracking-wider mb-4">
            {section.title}
          </h3>
          <ul class="space-y-3">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--color-text-secondary)] hover:text-brand-500 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-[var(--color-border)] py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[var(--color-text-muted)] max-w-xl">
        &copy; {new Date().getFullYear()} FunSona. Todos os direitos reservados. {BRAND_DISCLAIMER}
      </p>
      <div class="flex items-center gap-1.5 text-xs text-[var(--color-text-muted)]">
        <span>Feito com</span>
        <svg class="w-3.5 h-3.5 text-red-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <span>no Brasil</span>
      </div>
    </div>
  </div>
</footer>
