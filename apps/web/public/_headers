# Security headers used to live here, but they never actually applied: the
# Cloudflare adapter builds a custom _worker.js (Pages "Advanced Mode"), and
# in that mode Cloudflare ignores this file for any route the worker handles
# — which per _routes.json is nearly every route. They're set in
# src/middleware.ts instead, which is the only place they actually take
# effect. The Cache-Control rules below have the same limitation: they only
# apply to the paths _routes.json excludes from the worker (currently just
# /_astro/* and a few static files) — none of the routes below are excluded,
# so those rules are also inert today. Left as-is since fixing that is a
# separate change from the security-header bug this comment documents.

# Cache explore pages at the edge for fast category switching
/explore
  Cache-Control: public, s-maxage=30, stale-while-revalidate=60

/explore/*
  Cache-Control: public, s-maxage=30, stale-while-revalidate=60

# Cache static assets aggressively (they have content hashes in filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache auth or user-specific pages
/auth/*
  Cache-Control: no-store

/profile/*
  Cache-Control: no-store

/settings
  Cache-Control: no-store
