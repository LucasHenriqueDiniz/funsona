# Read by every script in this directory through
# `dotenv.config({ path: path.join(__dirname, ".env") })`.
# Copy this file to `scripts/migration/.env` and fill it in.
#
# The source Supabase project these scripts read from. Service role, because
# they read auth.users and bypass RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
