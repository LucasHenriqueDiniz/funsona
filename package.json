{
  "name": "funsona",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r --if-present lint",
    "release:ready": "node scripts/release/check-readiness.mjs",
    "typecheck": "pnpm --filter @funsona/shared build && pnpm -r typecheck",
    "db:generate": "supabase db diff -f",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "prepare": "git config --get core.hooksPath >/dev/null 2>&1 || git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.24.0"
}
