---
import type { LandingQuestion } from "@/lib/quiz-landing";

// Correct answers are deliberately withheld so the quiz stays worth playing.
interface Props {
  questions: LandingQuestion[];
  slug: string;
  title: string;
  type: string;
}

const { questions, slug, title, type } = Astro.props;
---

{questions.length > 0 && (
  <section class="relative mx-auto mb-8 max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-surface-elevated)] p-6 sm:p-8">
      <h2 class="text-xl font-black text-[var(--color-text-primary)]">
        As {questions.length} perguntas de "{title}"
      </h2>
      <p class="mt-2 text-sm font-medium text-[var(--color-text-muted)]">
        {type === "TRIVIA"
          ? "Veja tudo o que vai ser perguntado. As respostas certas aparecem só enquanto você joga."
          : "Veja tudo o que vai ser perguntado. Suas escolhas em cada pergunta definem o resultado final."}
      </p>

      <ol class="mt-6 space-y-6">
        {questions.map((question, index) => (
          <li class="border-t border-[var(--color-border)] pt-6 first:border-t-0 first:pt-0">
            <h3 class="flex gap-3 text-base font-black text-[var(--color-text-primary)] sm:text-lg">
              <span class="shrink-0 text-brand-500">{index + 1}.</span>
              <span>{question.title}</span>
            </h3>
            {question.options.length > 0 && (
              <ul class="mt-3 grid gap-2 sm:grid-cols-2 sm:pl-8">
                {question.options.map((option) => (
                  <li class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2.5 text-sm font-semibold text-[var(--color-text-secondary)]">
                    {option}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>

      <a href={`/quiz/${slug}/play`} class="mt-8 inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-brand-600 to-accent-600 px-6 py-3 font-black text-white transition hover:-translate-y-0.5">
        Responder as {questions.length} perguntas
      </a>
    </div>
  </section>
)}
