{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@funsona/web", "dev"],
      "port": 4321
    },
    {
      "name": "web-prod-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@funsona/web", "dev", "--mode", "production", "--port", "4322"],
      "port": 4322
    },
    {
      "name": "api-prod-copy",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@funsona/api", "exec", "wrangler", "dev", "--port", "8787", "--persist-to", ".wrangler/prod-copy"],
      "port": 8787
    },
    {
      "name": "web-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PUBLIC_API_URL=http://localhost:8787/api", "pnpm", "--filter", "@funsona/web", "dev", "--mode", "production", "--port", "4323"],
      "port": 4323
    }
  ]
}
